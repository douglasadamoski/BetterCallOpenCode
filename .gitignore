BETTERCALLCHATGPT_REVIEW_*.md
BETTERCALLGEMINI_REVIEW_*.md
BETTERCALLGROK_REVIEW_*.md

# Short-lived files next to reports
.bcmyai_wtest.*
.bcmyai_report.*

# Raw chafa / intermediate art
*.chafaraw.txt

# Python
__pycache__/
*.pyc
.pytest_cache/

# Live fixtures that might contain session noise (keep sample_ only)
tests/fixtures/live_*

